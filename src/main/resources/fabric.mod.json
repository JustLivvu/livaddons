    "issues": "https://github.com/justlivvu/livaddons/issues"
  },
  "license": "MIT",
  "icon": "assets/livaddons/icon.webp",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.livaddons.LivAddonsMod"
    ],
    "client": [
      "net.livaddons.LivAddonsClient"
    ]
  },
  "mixins": [
    "livaddons.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
